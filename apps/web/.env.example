# Web app environment variables (copy to .env.local for local dev)

# Dev-only: enables the Test Mode / faucet / mint-override UI. Never set in
# production builds (real deployments only expose the real token flows).
NEXT_PUBLIC_DEV_TOOLS=

# Public site origin used for canonical URLs, OGP, and the sitemap.
# Production: https://egavel.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API base URL for browser fetches (no /api suffix). Defaults to localhost.
NEXT_PUBLIC_API_URL=http://localhost:3001

# API base URL for server-side fetches (no /api suffix). In Docker the server
# is reached over the internal network; on Vercel point this at the Worker.
SSR_API_URL=http://localhost:3001
