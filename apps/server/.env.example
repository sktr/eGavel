# Nostr private key (nsec or hex format)
# Required for signing settlement/bid events. Without it, the server runs
# but cannot sign or decrypt Nostr events.
NOSTR_PRIVATE_KEY=nsec1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated relay URLs
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol

# HTTP listen port (web app uses 3000, so server uses 3001 to avoid conflict)
PORT=3001

# SQLite database file path (relative to apps/server)
DB_PATH=data/auction.db

# Allow test-mode bids (mint_url = test://local) — dev only, keep off in prod
ALLOW_TEST_BIDS=1

# Seller-paid fee in basis points (500 = 5%), split at claim time
AUCTION_FEE_BPS=500
