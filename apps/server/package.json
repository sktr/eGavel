{
  "name": "@egavel/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:worker": "wrangler dev --port 8788",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@egavel/shared": "workspace:*",
    "@cashu/cashu-ts": "^4.5.0",
    "@hono/node-server": "^1.14.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "better-sqlite3": "^11.8.0",
    "dotenv": "^17.4.2",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.121.0"
  }
}
